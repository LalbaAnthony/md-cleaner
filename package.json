{
  "name": "@lalba-anthony/md-cleaner",
  "version": "1.0.1",
  "description": "Cleans up Markdown files by removing AI fingerprints.",
  "keywords": [
    "cli",
    "markdown",
    "AI",
    "terminal"
  ],
  "type": "module",
  "bin": {
    "md-cleaner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "author": "Anthony Lalba",
  "homepage": "https://github.com/LalbaAnthony/md-cleaner#readme",
  "bugs": {
    "url": "https://github.com/LalbaAnthony/md-cleaner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LalbaAnthony/md-cleaner.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --declaration false --declarationMap false",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
